# =============================================================================
# iNWEB Browser — GN arguments: DEVELOPMENT channel
#
# STATUS: DRAFT — authored in Phase 1; validated at the first real build on
# build infrastructure (blocker B-001). Corrections are committed back here.
#
# Reference: upstream docs/android_build_instructions.md
# =============================================================================

# Android target on an x86-64 Linux build host, 64-bit ARM device target.
target_os = "android"
target_cpu = "arm64"

# Phase 6 probe: opt into Chromium's existing experimental Android extension
# core without claiming the full desktop extensions system. User-facing
# surfaces remain separately gated until build, API-audit, and device proof.
enable_inweb_android_extensions = true

# Fast iteration for patch development. NOTE: component builds are
# disallowed on Android upstream (BUILDCONFIG.gn asserts
# !(current_os == "android" && is_component_build)) — first real-build
# correction from B-001 Stage-1 run 34689824373: is_component_build
# removed. Debug + symbol_level=1 stays the fast-iteration config.
is_debug = true
symbol_level = 1

# Distribution outside Play Store during development.
android_channel = "default"

# iNWEB application identity (ADR-038): Chromium's supported rebranding
# argument (declare_args in chrome/android/chrome_public_apk_tmpl.gni).
# android_channel = "default" appends no suffix, so the id stays exactly
# com.inweb.android. Permanent once released (updates require same id).
chrome_public_manifest_package = "com.inweb.android"

# Android identity (VERSIONING §3). versionName carries the iNWEB semver
# string EXACTLY; versionCode = MAJOR*1e6 + MINOR*1e4 + PATCH*100 +
# channelRank(alpha.N -> N) = 1,000,002 for 1.0.0-alpha.2. BOTH must be
# bumped together at every release and recorded in the Appendix A
# registry in docs/VERSIONING.md; the registry, not the formula, is the
# source of truth.
android_override_version_name = "1.0.0-alpha.2"
android_override_version_code = "1000002"
