# iNWEB Browser — native ad-block engine build (patch 0005, ADR-040).
#
# Sources are authored at src/native/adblock/ in the iNWEB repository and
# synced into this patch; the patch series is the single authority for the
# Chromium tree.

source_set("inweb_adblock_engine") {
  sources = [
    "inweb_default_filter_list.cc",
    "inweb_default_filter_list.h",
    "inweb_domain_classifier.cc",
    "inweb_domain_classifier.h",
    "inweb_filter_list_cache.cc",
    "inweb_filter_list_cache.h",
    "inweb_filter_list_checksum.cc",
    "inweb_filter_list_checksum.h",
    "inweb_filter_list_fetcher.h",
    "inweb_filter_list_manager.cc",
    "inweb_filter_list_manager.h",
    "inweb_filter_list_parser.cc",
    "inweb_filter_list_parser.h",
    "inweb_filter_list_source.cc",
    "inweb_filter_list_source.h",
    "inweb_filter_list_version.cc",
    "inweb_filter_list_version.h",
    "inweb_filter_rule.h",
    "inweb_pattern_compiler.cc",
    "inweb_pattern_compiler.h",
    "inweb_request_context.h",
    "inweb_resource_type.h",
    "inweb_rule_matcher.cc",
    "inweb_rule_matcher.h",
    "inweb_security_center.cc",
    "inweb_security_center.h",
    "inweb_tracking_protection_engine.cc",
    "inweb_tracking_protection_engine.h",
    "inweb_update_policy.h",
  ]

  deps = [
    "//base",
    "//crypto",
    "//net",
    "//third_party/re2",
    "//url",
  ]
}

# URL-loader throttle + engine holder (patch 0006): wires the engine into
# the network stack. Registered from ChromeContentBrowserClient.
source_set("inweb_adblock_throttle") {
  sources = [
    "inweb_adblock_engine_holder.cc",
    "inweb_adblock_engine_holder.h",
    "inweb_adblock_url_loader_throttle.cc",
    "inweb_adblock_url_loader_throttle.h",
    "inweb_request_destination_map.cc",
    "inweb_request_destination_map.h",
  ]

  deps = [
    ":inweb_adblock_engine",
    "//base",
    "//net",
    "//services/network/public/cpp",
    "//third_party/blink/public/common",
    "//url",
  ]
}

source_set("unittests") {
  testonly = true
  sources = [
    "inweb_adblock_engine_holder_unittest.cc",
    "inweb_adblock_url_loader_throttle_unittest.cc",
    "inweb_domain_classifier_unittest.cc",
    "inweb_filter_list_cache_unittest.cc",
    "inweb_filter_list_manager_unittest.cc",
    "inweb_filter_list_parser_unittest.cc",
    "inweb_filter_list_stack_unittest.cc",
    "inweb_request_destination_map_unittest.cc",
    "inweb_rule_matcher_unittest.cc",
    "inweb_security_center_unittest.cc",
    "inweb_tracking_protection_engine_unittest.cc",
  ]

  deps = [
    ":inweb_adblock_engine",
    ":inweb_adblock_throttle",
    "//base/test:test_support",
    "//testing/gtest",
    "//testing/gmock",
  ]
}
