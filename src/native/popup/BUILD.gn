# iNWEB Browser — popup protection build (patches 0008–0011).
#
# Sources are authored at src/native/popup/ in the iNWEB repository and
# synced into this patch; the patch series is the single authority for the
# Chromium tree.

source_set("inweb_popup_guard") {
  sources = [
    "inweb_popup_guard.cc",
    "inweb_popup_guard.h",
  ]

  deps = [
    "//base",
    "//chrome/android/inweb/adblock:inweb_adblock_throttle",
    "//third_party/re2",
    "//url",
  ]
}

source_set("inweb_redirect_guard") {
  sources = [
    "inweb_redirect_guard.cc",
    "inweb_redirect_guard.h",
  ]

  deps = [
    "//base",
    "//chrome/android/inweb/adblock:inweb_adblock_throttle",
    "//third_party/re2",
    "//url",
  ]
}

source_set("inweb_download_guard") {
  sources = [
    "inweb_download_guard.cc",
    "inweb_download_guard.h",
  ]

  deps = [
    "//base",
    "//chrome/android/inweb/adblock:inweb_adblock_throttle",
    "//third_party/re2",
    "//url",
  ]
}

source_set("inweb_notification_policy") {
  sources = [
    "inweb_notification_policy.cc",
    "inweb_notification_policy.h",
  ]

  deps = [
    "//base",
    "//url",
  ]
}

source_set("inweb_notification_policy_ui_selector") {
  sources = [
    "inweb_notification_policy_ui_selector.cc",
    "inweb_notification_policy_ui_selector.h",
  ]

  deps = [
    ":inweb_notification_policy",
    "//base",
    "//components/permissions",
    "//components/content_settings/core/common",
  ]
}

source_set("inweb_redirect_throttle") {
  sources = [
    "inweb_redirect_throttle.cc",
    "inweb_redirect_throttle.h",
  ]

  deps = [
    ":inweb_redirect_guard",
    "//base",
    "//content/public/browser",
    "//net",
    "//third_party/re2",
    "//url",
  ]
}

source_set("unittests") {
  testonly = true
  sources = [
    "inweb_download_guard_unittest.cc",
    "inweb_notification_policy_unittest.cc",
    "inweb_popup_guard_unittest.cc",
    "inweb_redirect_guard_unittest.cc",
  ]

  deps = [
    ":inweb_popup_guard",
    ":inweb_redirect_guard",
    "//base",
    "//chrome/android/inweb/adblock:inweb_adblock_engine",
    "//testing/gtest",
    "//testing/gmock",
    "//third_party/re2",
  ]
}
