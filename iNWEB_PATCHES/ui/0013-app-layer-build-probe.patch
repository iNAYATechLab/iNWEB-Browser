+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.inweb.app
+
+import androidx.compose.material3.Text
+import androidx.compose.runtime.Composable
+
+/**
+ * Build probe for patch 0013 — not a product surface.
+ *
+ * Its only purpose is to make the Compose compiler plugin run inside the
+ * real Chromium build: if this file compiles, the authored Kotlin +
+ * Compose app layer has a working path into ChromePublic.apk, and the
+ * remaining work is wiring the real sources, not discovering a mechanism.
+ * It is removed when the real app-layer injection lands.
+ */
+@Composable
+fun InwebProbeLabel(text: String) {
+    Text(text = text)
+}
