+# iNWEB Browser — authored app layer (patch 0013, build probe).
+#
+# Sources are authored at src/android-app/ and src/core/ in the iNWEB
+# repository and synced into this patch; the patch series is the single
+# authority for the Chromium tree.
+#
+# PROBE ONLY. This target carries one trivial composable whose only job is
+# to prove that Kotlin compiles and the Jetpack Compose compiler plugin
+# runs inside the Chromium build. It is replaced by the real app-layer
+# injection once that is proven, and it is never a user-facing surface.
+
+import("//build/config/android/rules.gni")
+
+android_library("inweb_app_java") {
+  sources = [ "InwebProbe.kt" ]
+
+  # internal_rules.gni compile_kt() adds the Compose compiler plugin
+  # (//third_party/kotlinc/current/lib/compose-compiler-plugin.jar) when
+  # this is set; without it @Composable functions do not compile.
+  enable_compose = true
+
+  deps = [
+    "//third_party/androidx:androidx_compose_foundation_foundation_java",
+    "//third_party/androidx:androidx_compose_material3_material3_java",
+    "//third_party/androidx:androidx_compose_runtime_runtime_java",
+    "//third_party/androidx:androidx_compose_ui_ui_java",
+    "//third_party/kotlin_stdlib:kotlin_stdlib_java",
+  ]
+}
